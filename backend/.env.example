# Copy to backend/.env for local development (never commit a real .env file).
# Leave DATABASE_URL blank for the local SQLite database.
# Vercel production must set DATABASE_URL to the Supabase PostgreSQL transaction-pooler URL.
DATABASE_URL=

# Local development only. Set a long, unique secret in Vercel Project Settings for production.
APP_AUTH_SECRET=local-development-only-change-this-secret
TOKEN_TTL_SECONDS=28800
PBKDF2_ITERATIONS=420000
